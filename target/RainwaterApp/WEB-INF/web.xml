<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

    <filter>
        <filter-name>cors</filter-name>
        <filter-class>filter.CORSFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>cors</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>


